 #include "vk_framebuffer.h"
 
 #include "drm-uapi/panfrost_drm.h"
+#include "drm-uapi/mali_kbase_ioctl.h"
+#include <poll.h>
+#include <stdio.h>
+
+struct panvk_kbase_event_v2 {
+   uint32_t event_code;
+   uint8_t atom_number;
+   uint8_t padding[3];
+   uint64_t udata[2];
+};
+
+static int
+panvk_kbase_submit_and_wait(int fd, uint64_t jc, uint32_t core_req)
+{
+   uint8_t atom_bytes[64];
+   memset(atom_bytes, 0, sizeof(atom_bytes));
+   memcpy(atom_bytes + 0, &jc, 8);
+   atom_bytes[40] = 1;
+   memcpy(atom_bytes + 44, &core_req, 4);
+
+   struct kbase_ioctl_job_submit submit = {
+      .addr = (uint64_t)(uintptr_t)atom_bytes,
+      .nr_atoms = 1,
+      .stride = 56, /* FIX: 56 = sizeof(base_jd_atom_v2) real en UAPI 11.46; 64 causaba JOB_CONFIG_FAULT */
+   };
+
+   fprintf(stderr, "PANVK_KBASE_DEBUG: submitting jc=0x%llx core_req=0x%x\n",
+           (unsigned long long)jc, core_req);
+
+   if (ioctl(fd, KBASE_IOCTL_JOB_SUBMIT, &submit)) {
+      fprintf(stderr, "PANVK_KBASE_DEBUG: JOB_SUBMIT ioctl failed: errno=%d\n", errno);
+      return -errno;
+   }
+
+   struct pollfd pfd = { .fd = fd, .events = POLLIN };
+   int pret = poll(&pfd, 1, 5000);
+   fprintf(stderr, "PANVK_KBASE_DEBUG: poll returned %d, revents=0x%x\n", pret, pfd.revents);
+   if (pret <= 0 || !(pfd.revents & POLLIN))
+      return -110;
+
+   struct panvk_kbase_event_v2 event;
+   ssize_t n = read(fd, &event, sizeof(event));
+   fprintf(stderr, "PANVK_KBASE_DEBUG: read %zd bytes, event_code=0x%x atom_number=%u\n",
+           n, event.event_code, event.atom_number);
+   if (n != sizeof(event))
+      return -5;
+
+   if (event.event_code != 0x1) {
+      fprintf(stderr, "PANVK_KBASE_DEBUG: non-DONE event_code=0x%x, returning fault\n",
+              event.event_code);
+      return -(int)event.event_code;
+   }
+
+   return 0;
+}
 
